# PostgreSQL connection string
DATABASE_URL=postgres://sparta:CHANGE_ME@localhost:5432/sparta_motors

# Long random string — generate with: openssl rand -hex 32
PAYLOAD_SECRET=CHANGE_ME

# Public site URL (no trailing slash).
# Read at BUILD time — changing the domain later means a rebuild, not a restart.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Where Payload writes uploaded photos. Must match the `alias` in
# deploy/nginx.conf, or photos upload fine and then 404 on the site.
MEDIA_DIR=/var/www/sparta-motors/media

# Optional. Extra comma-separated origins allowed to call the API / log in to
# the admin, on top of NEXT_PUBLIC_SITE_URL. Use when the office LAN IP changes.
# ALLOWED_ORIGINS=http://192.168.1.50:3000

# SMTP — send lead/workflow notifications through the business email.
# Leave SMTP_HOST empty in local dev to disable actual sending (emails are logged instead).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@sparta-motors.com
SMTP_PASSWORD=app-specific-password
SMTP_FROM=info@sparta-motors.com
NOTIFICATION_TO=admin@sparta-motors.com

# Initial admin login, used once by `npm run seed`. Remove after first deploy.
SEED_ADMIN_EMAIL=CHANGE_ME
SEED_ADMIN_PASSWORD=CHANGE_ME
